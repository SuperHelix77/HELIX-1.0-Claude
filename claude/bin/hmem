#!/usr/bin/env python3
# hmem q "terms" [-k N] | hmem raw SEQ [maxchars] | hmem stats
# hmem claim add "text" --status CONFIRMED|FALSIFIED|OPEN [--scope S] [--ev REF].. [--file PATH].. [--supersedes ID] [--type T]
# hmem claim ls [--all] | hmem claim q terms | hmem claim show ID
# Helix Memory CLI: query the lossless archive directly (instead of carrying history in context).
import sys,os,re,json
sys.path.insert(0,os.path.join(os.environ.get('HELIX_HOME') or os.environ.get('HELIX_LEAN_HOME') or os.path.expanduser('~/.claude-lean'),'lib')); import hmem,claims
SESS=os.environ.get('HELIX_SESSION')
if not SESS:  # default to this project's archive (adapter key) so #seq handles resolve to the right session
    import hashlib; _k='p-'+hashlib.sha256(os.path.abspath(os.getcwd()).encode()).hexdigest()[:10]
    try: SESS=_k if hmem.connect().execute('SELECT 1 FROM unit WHERE session=? LIMIT 1',(_k,)).fetchone() else None
    except Exception: SESS=None
def snippet(uid,q,w=240):
    t=hmem.raw(uid) or ''; toks=[x for x in re.findall(r'[A-Za-z0-9_.\-/]{2,}',q)]
    best=-1
    for x in toks:
        i=t.lower().find(x.lower())
        if i>=0 and (best<0 or i<best): best=i
    a=max(0,best-60) if best>=0 else 0
    return re.sub(r'\s+',' ',t[a:a+w])
A=sys.argv[1:]
if not A: sys.exit(__doc__)
if A[0]=='claim':
    sub=A[1] if len(A)>1 else 'ls'; R=A[2:]
    def opt(flag,multi=False):
        v=[]
        while flag in R: i=R.index(flag); v.append(R[i+1]); del R[i:i+2]
        return v if multi else (v[0] if v else None)
    if sub=='add':
        st=opt('--status'); sc=opt('--scope') or ''; ev=opt('--ev',True); fl=opt('--file',True); sp=opt('--supersedes'); ty=opt('--type') or 'experiment_result'
        txt=' '.join(R)
        try: print('claim',claims.add(txt,st or 'OPEN',sc,ev,fl,sp,ty,session=SESS or 's0'))
        except Exception as e: sys.exit(f'error: {e}')
    elif sub in('ls','q'):
        allc='--all' in R; R=[r for r in R if r!='--all']
        L=claims.all_claims() if allc else claims.current()
        if sub=='q': L=claims.search(' '.join(R),8)
        order={'FALSIFIED':0,'CONFIRMED':1,'OPEN':2}
        for d in sorted(L,key=lambda d:(d['effective']=='STALE',order.get(d['status'],3))): print(claims.fmt(d))
    elif sub=='show':
        d=claims.find(R[0])
        print(claims.card(d) if d else 'not found / ambiguous')
    sys.exit(0)
if A[0]=='q':
    k=5
    for d in claims.search(' '.join(A[1:]),3): print('CLAIM',claims.fmt(d))
    if '-k' in A: i=A.index('-k'); k=int(A[i+1]); del A[i:i+2]
    q=' '.join(A[1:])
    for r in hmem.search(q,k,session=SESS):
        print(f"#{r['seq']} {r['kind']} | {snippet(r['id'],q)}")
elif A[0]=='raw':
    c=hmem.connect(); row=c.execute('SELECT id FROM unit WHERE seq=?'+(' AND session=?' if SESS else '')+' LIMIT 1',(int(A[1]),)+((SESS,) if SESS else ())).fetchone()
    print(hmem.raw(row['id'],maxc=int(A[2]) if len(A)>2 else 2500) if row else 'not found')
elif A[0]=='stats':
    for r in hmem.stats(session=SESS): print(r)
